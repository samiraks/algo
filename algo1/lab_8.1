import java.io.*;
import java.util.*;

public class Main {

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));//читает большими кусками в буфер и отдаёт целые строки через readLine()
        StringTokenizer st = new StringTokenizer(br.readLine()); //разбивает строку на «токены» по пробелам.

        int n = Integer.parseInt(st.nextToken()); //превращает строку в число
        long[] p = new long[n + 1]; // массив префиксных сумм размера n+1

        st = new StringTokenizer(br.readLine()); //чтение второй строки входных данных
        for (int k = 1; k <= n; k++) {
            p[k] = p[k - 1] + Integer.parseInt(st.nextToken());
        }

        StringBuilder sb = new StringBuilder(); //склеивает всё в память, а печатаем один раз в конце

        String line;
        while ((line = br.readLine()) != null && !line.isEmpty()) {
            st = new StringTokenizer(line);//разрезает её по пробелу на куски
            int i = Integer.parseInt(st.nextToken());//вытаскивает первый кусок и делает из него число
            int j = Integer.parseInt(st.nextToken());
            sb.append(p[j + 1] - p[i]).append('\n');
        }

        System.out.print(sb);
    }
}
